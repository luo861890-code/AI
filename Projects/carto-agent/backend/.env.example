# ========== LLM配置 ==========
# 默认LLM提供者: deepseek（API Key已内置） / ollama / qwen / openai / zhipu
LLM_PROVIDER=deepseek

# Ollama本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# 通义千问API配置
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI API配置
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API配置（默认Key已内置在 app/core/config.py；如需覆盖请取消注释并填写）
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱API配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ========== Neo4j知识图谱配置 ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123

# ========== 地图数据配置 ==========
# Overpass API服务器（多个用逗号分隔）
OVERPASS_SERVERS=https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# 高德API配置（可选，多源数据融合适配器读取；AMAP_API_KEY 为兼容旧名）
AMAP_KEY=your_amap_key_here
AMAP_API_KEY=

# 天地图API Key（用于多源数据融合适配器的矢量底图服务）
TIANDITU_KEY=a3bb2eed53ecf1d9a3c852f0ab4d27de

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据目录
DATA_DIR=../data
