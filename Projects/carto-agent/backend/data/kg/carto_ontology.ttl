@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix carto: <http://cartoagent.example/ontology#> .

# ===== 本体类（7类核心概念） =====
carto:MapElement a owl:Class ; rdfs:label "地图要素 - 地理实体在地图上的抽象表示" .
carto:MapSymbol a owl:Class ; rdfs:label "地图符号 - 地图要素的视觉表达规范" .
carto:CartographicData a owl:Class ; rdfs:label "制图数据 - 地图制作的数据来源与格式" .
carto:MapProjection a owl:Class ; rdfs:label "地图投影 - 地理坐标系与投影方式" .
carto:InfluencingFactor a owl:Class ; rdfs:label "影响因素 - 影响制图决策的各种因素" .
carto:CartographicDecision a owl:Class ; rdfs:label "制图行为决策 - 特定条件下的制图方案选择" .
carto:LayerConfig a owl:Class ; rdfs:label "图层配置 - 地图类型对应的图层叠置方案" .

# ===== 实例（知识图谱三元组） =====
carto:traffic a carto:MapElement ; rdfs:label "traffic" .
carto:tourism a carto:MapElement ; rdfs:label "tourism" .
carto:campus a carto:MapElement ; rdfs:label "campus" .
